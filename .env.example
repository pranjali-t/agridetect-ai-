# AI-Based Crop Disease Detection System - Environment Configuration
# Phase 1: Frontend prototype operates in mock preview mode when VITE_API_URL is empty
# Phase 2: Set VITE_API_URL to point to your running FastAPI backend (e.g., http://localhost:8000)

VITE_API_URL=http://localhost:8000

# Optional configuration flags
VITE_APP_TITLE=AI-Based Crop Disease Detection System
VITE_ENABLE_MOCK_FALLBACK=true
